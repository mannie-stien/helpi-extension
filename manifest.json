{
  "manifest_version": 3,
"name": "Helpi – AI Assistant for Summarizing, Explaining & Translating",
  "short_name": "Helpi-AI",
  "author": "Mannie",
  "version": "0.1.2",
  "description": "Highlight any text and get instant help—Helpi explains, translates, summarizes, and solves directly on the page you're reading.",
  "icons": {
    "16": "/assets/icons/icon.png",
    "48": "/assets/icons/icon.png",
    "128": "/assets/icons/icon.png"
  },
  "permissions": ["activeTab", "storage", "sidePanel", "commands"],
  "host_permissions": [
    "https://api.together.xyz/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "/assets/icons/icon.png",
      "32": "/assets/icons/icon.png",
      "48": "/assets/icons/icon.png",
      "128": "/assets/icons/icon.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.js"],
      "css": ["src/content/styles.css"],
      "type": "module",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/assistant.js",
        "src/content/callTogetherAPI.js",
        "src/content/detectContext.js",
        "src/content/styles.js",
        "src/content/apiProviders.js",
        "src/content/keyboardShortcuts.js",
        "src/content/conversationManager.js",
        "src/content/visualContentHandler.js",
        "src/sidepanel/sidepanel.html",
        "src/sidepanel/sidepanel.css",
        "src/sidepanel/sidepanel.js",
        "dist/output.css",
        "assets/fonts/*",
        "assets/icons/*",
        "assets/store/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "toggle-assistant": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "Command+Shift+H"
      },
      "description": "Toggle Helpi assistant"
    },
    "quick-explain": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Explain selected text"
    },
    "summarize-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Summarize current page"
    }
  }
}
